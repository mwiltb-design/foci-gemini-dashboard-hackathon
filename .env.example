# =============================================================================
# Pi-Dashboards Desktop Configuration
# Copy this file to .env to customize your local settings.
# =============================================================================

# Application Ports
# Local server/backend default: 4317. Cloud Run overrides PORT=8080.
PORT=4317
HOST=127.0.0.1
# Vite UI dev server default: 5173
VITE_PORT=5173

# Workspace Root (Defaults to ~/Pi-Dashboards/Default)
# PI_DASHBOARD_WORKSPACE=C:/Users/YourName/Pi-Dashboards/Default

# Gemini hackathon configuration
GEMINI_API_KEY=your-gemini-api-key
FOCI_AGENT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash
GEMINI_WORKER_MODEL=gemini-3.5-flash

# -----------------------------------------------------------------------------
# Remote Access & Tailscale Serve (Can also be configured directly in Settings UI)
# -----------------------------------------------------------------------------
# DASHBOARD_ALLOWED_HOSTS=my-computer.tailnet.ts.net
# PI_DASHBOARD_ALLOWED_ORIGINS=https://my-computer.tailnet.ts.net:8443
# Optional: require this token for remote dashboard access.
# PI_DASHBOARD_AUTH_TOKEN=your-strong-secret-password

# Optional Pre-configured AI Provider API Key (can also be configured via UI)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
