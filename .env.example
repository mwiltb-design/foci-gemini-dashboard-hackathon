# =============================================================================
# Pi-Dashboard Desktop Configuration
# Copy this file to .env to customize your local settings.
# =============================================================================

# Application Port (Default: 5173. Use 5190 or any open port if 5173 is occupied)
PORT=5173
HOST=127.0.0.1

# Backend API Port (Default: 4317)
BACKEND_PORT=4317

# Workspace Folder (Defaults to ~/Documents/PiWorkspace if unset)
# PI_WORKSPACE=C:/Users/YourName/Documents/PiWorkspace

# Optional Auth Token for Private Remote / Tailscale Access
# PI_DASHBOARD_AUTH_TOKEN=

# Optional Pre-configured AI Provider API Key (can also be configured via UI)
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
